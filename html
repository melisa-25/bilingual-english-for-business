    }

    function checkFIB() {
        for (let i = 1; i <= 10; i++) {
            let input = document.getElementById('fib' + i);
            let userVal = input.value.trim().toLowerCase();
            let correctVal = input.getAttribute('data-answer').toLowerCase();

            // Ignore case and minor extra whitespace for flexible checking
            if (userVal === correctVal) {
                input.classList.remove('incorrect');
                input.classList.add('correct');
            } else {
                input.classList.remove('correct');
                input.classList.add('incorrect');
            }
        }
        alert("Pemeriksaan pola kalimat selesai! Kotak hijau menandakan benar, kotak merah menandakan perlu diperbaiki.");
    }

    function checkAnswers() {
        for (let i = 1; i <= 10; i++) {
            let radios = document.getElementsByName('q' + i);
            let exp = document.getElementById('exp' + i);
            let answeredCorrectly = false;
            
            for (let r of radios) {
                if (r.checked && r.getAttribute('data-correct') === 'true') {
                    answeredCorrectly = true;
                }
            }

            if (!answeredCorrectly) {
                exp.style.display = 'block';
            } else {
                exp.style.display = 'none';
            }
        }
        alert("Pemeriksaan kuis pilihan ganda selesai! Penjelasan muncul pada soal yang jawabannya keliru.");
    }
</script>

